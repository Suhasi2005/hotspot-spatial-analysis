# Optional settings. Safe placeholders only: no secrets, no machine-specific paths.
#
# The application reads these from REAL environment variables (config/settings.py).
# It does NOT load a .env file automatically: copying this file to .env has no
# effect on its own. Set the variables in your shell before launching, e.g.
#   PowerShell:  $env:HOTSPOT_REPORTS_DIR = "reports"
#   bash:        export HOTSPOT_REPORTS_DIR=reports
# All values are optional; config/settings.py has defaults for each.

# Where the SQLite history database lives (relative to project root).
HOTSPOT_DB_PATH=data/processed/analysis_history.sqlite3

# Where generated CSV/PDF reports are written (relative to project root).
HOTSPOT_REPORTS_DIR=reports

# Logging level: DEBUG, INFO, WARNING, ERROR.
# Currently read into config.settings.LOG_LEVEL but has NO effect: no logging is configured.
HOTSPOT_LOG_LEVEL=INFO
